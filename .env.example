# 1. Copy this file and rename the copy to ".env"
# 2. Paste your free Gemini API key from https://aistudio.google.com/apikey
# 3. Never upload the .env file to GitHub (it is listed in .gitignore)

GEMINI_API_KEY=your_gemini_api_key_here

# Optional: choose a different Gemini model. "gemini-flash-latest" always
# points to Google's newest Flash model. See https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-flash-latest
